<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#022c22" />
    </linearGradient>
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#34d399" />
      <stop offset="50%" stop-color="#10b981" />
      <stop offset="100%" stop-color="#06b6d4" />
    </linearGradient>
    <linearGradient id="coreGlow" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#6ee7b7" />
      <stop offset="100%" stop-color="#059669" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="2.5" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Rounded Premium Container -->
  <rect width="64" height="64" rx="16" fill="url(#bgGrad)" stroke="#10b981" stroke-opacity="0.35" stroke-width="2" />

  <!-- Outer Architectural Diamond / Hex Lattice -->
  <polygon points="32,10 52,22 52,42 32,54 12,42 12,22" stroke="url(#accentGrad)" stroke-width="2.5" stroke-linejoin="round" fill="none" opacity="0.4" />

  <!-- Glowing Core Architectural 'A' & Neural Node -->
  <g filter="url(#glow)">
    <!-- Sleek Stylized Architect 'A' -->
    <path d="M32 15 L45 45 L38 45 L32 30 L26 45 L19 45 Z" fill="url(#accentGrad)" />
    <!-- Core Crossbar Bridge -->
    <rect x="25" y="34" width="14" height="3" rx="1.5" fill="#a7f3d0" />
    <!-- Quantum Apex Spark -->
    <circle cx="32" cy="16" r="2.5" fill="#ffffff" />
    <!-- Bottom Anchor Nodes -->
    <circle cx="21" cy="45" r="1.8" fill="#34d399" />
    <circle cx="43" cy="45" r="1.8" fill="#34d399" />
  </g>

  <!-- Subtle High-tech Corner Accents -->
  <line x1="8" y1="16" x2="16" y2="8" stroke="#10b981" stroke-width="1.5" stroke-linecap="round" opacity="0.6" />
  <line x1="56" y1="48" x2="48" y2="56" stroke="#06b6d4" stroke-width="1.5" stroke-linecap="round" opacity="0.6" />
</svg>
